<Window x:Class="WinAemeath.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinAemeath"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Canvas x:Name="RootCanvas">
        <!-- 左上角图片 -->
        <Image x:Name="TopLeftImage"
               Source="img_left_top.png"
               Width="150" Height="150"
               Canvas.Left="0" Canvas.Top="0"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- 左下角图片 -->
        <Image x:Name="BottomLeftImage"
               Source="img_left_bottom.png"
               Width="150" Height="150"
               Canvas.Left="0" Canvas.Bottom="0"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- 右下角图片 -->
        <Image x:Name="BottomRightImage"
       Source="img_right_bottom.png"
       Width="150" Height="150"
       Canvas.Left="0" Canvas.Bottom="0"
       RenderOptions.BitmapScalingMode="HighQuality"/>
    </Canvas>
</Window>
